# Copy to .env in the repo root. Everything is optional.

# AI provider order: ANTHROPIC_API_KEY → local Claude Code login (Claude Agent SDK) → built-in engine.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_PROVIDER=auto        # api | agent-sdk | off
# AGENT_SDK_PROBE=0       # skip the startup check of the local Claude Code login
# AI_DISABLED=1           # force the built-in engine (instant, offline demos)

# Partner API keys are created in the Integration Portal (/portal) — nothing to configure here.
# Portal admin (integrations@paytm.demo). Outside production a demo password is used if unset;
# in production the admin is only created when this is set.
# PORTAL_ADMIN_PASSWORD=
# PORTAL_DEMO=1 adds a one-click “Use demo account” to the portal sign-in (never in production).
PORTAL_DEMO=1

# "Continue with Paytm" has no SMS provider in the demo. OTP_DEMO=1 shows the code on screen
# (any phone in development; only the seeded demo numbers in production). Leave unset to disable.
OTP_DEMO=1

# API port (also serves the built app in production). The dev app always runs on 7100.
PORT=7101
# JWT_SECRET=            # random one is generated and kept in server/data/.jwt-secret if unset
# DB_FILE=               # default server/data/spend.db
# CLIENT_ORIGIN=         # comma-separated origins if the client is hosted separately
