# Copy to .env in the repo root. Everything is optional.

# AI provider order: ANTHROPIC_API_KEY → local Claude Code login (Claude Agent SDK) → built-in engine.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_PROVIDER=auto        # api | agent-sdk | off
# AGENT_SDK_PROBE=0       # skip the startup check of the local Claude Code login
# AI_DISABLED=1           # force the built-in engine (instant, offline demos)

# Key Paytm (or any partner) sends as `x-api-key` to /api/paytm/*
PAYTM_API_KEY=demo-paytm-partner-key

PORT=4400
# JWT_SECRET=            # random one is generated and kept in server/data/.jwt-secret if unset
# DB_FILE=               # default server/data/spend.db
# CLIENT_ORIGIN=         # comma-separated origins if the client is hosted separately
